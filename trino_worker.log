deduped_tvl AS (
    SELECT
        block_date,
        pool_address,
        dex,
        total_tvl_usd,
        vault_mint_1,
        vault_mint_2
    FROM (
        SELECT
            block_date,
            pool_address,
            dex,
            total_tvl_usd,
            vault_mint_1,
            vault_mint_2,
            ROW_NUMBER() OVER (PARTITION BY block_date, pool_address ORDER BY total_tvl_usd DESC) as rn
        FROM solana.dex_tvl
        WHERE block_date < CURRENT_DATE
    ) t
    WHERE rn = 1
),

active_pools AS (
    SELECT block_date, pool_address
    FROM solana.dex_trades
    WHERE block_date < CURRENT_DATE
    GROUP BY 1, 2
)

SELECT
    d.block_date,
    pn.program_name as dex,
    COUNT(DISTINCT CASE WHEN ap.pool_address IS NOT NULL THEN d.pool_address END) as active_pools,
    ROUND(SUM(d.total_tvl_usd), 2) as tvl_usd
FROM deduped_tvl d
JOIN program_names pn ON d.dex = pn.program
LEFT JOIN active_pools ap ON d.pool_address = ap.pool_address AND d.block_date = ap.block_date
WHERE NOT (
      COALESCE(d.total_tvl_usd, 0) > 100 * 1e6
      AND d.vault_mint_1 NOT IN (SELECT mint FROM cte_mints)
      AND d.vault_mint_2 NOT IN (SELECT mint FROM cte_mints)
  )
GROUP BY 1, 2
ORDER BY d.block_date, tvl_usd DESC
