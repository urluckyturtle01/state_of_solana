deduped_tvl AS (
    SELECT
        block_date,
        pool_address,
        total_tvl_usd,
        vault_mint_1,
        vault_mint_2
    FROM (
        SELECT
            block_date,
            pool_address,
            total_tvl_usd,
            vault_mint_1,
            vault_mint_2,
            ROW_NUMBER() OVER (PARTITION BY block_date, pool_address ORDER BY total_tvl_usd DESC) as rn
        FROM solana.dex_tvl
        WHERE DATE_TRUNC('month', block_date) = DATE('2026-03-01')
          AND block_date < CURRENT_DATE
    ) t
    WHERE rn = 1
),

filtered_pools AS (
