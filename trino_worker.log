SELECT 
    d.block_date,
    COALESCE(p.program_name, d.inner_program) as program_name,
    SUM(d.compute_units_consumed) as total_compute_units,
    ROUND(AVG(d.compute_units_consumed), 0) as avg_cu_per_txn
FROM (
    SELECT DISTINCT block_date, block_slot, tx_index, inner_program, compute_units_consumed
    FROM solana.dex_trades
    WHERE DATE_TRUNC('month', block_date) = DATE('2026-03-01')
      AND block_date < CURRENT_DATE
) d
JOIN program_names p ON d.inner_program = p.program
GROUP BY d.block_date, d.inner_program, p.program_name
ORDER BY d.block_date, total_compute_units DESC

