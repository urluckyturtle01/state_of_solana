            WHEN (sold_is_sol = 1 AND bought_is_stable = 0) OR (bought_is_sol = 1 AND sold_is_stable = 0)
                THEN 'SOL-Other'
            -- Stable-Other: one side stablecoin, other side NOT SOL and NOT stablecoin
            WHEN (sold_is_stable = 1 AND bought_is_sol = 0 AND bought_is_stable = 0) 
              OR (bought_is_stable = 1 AND sold_is_sol = 0 AND sold_is_stable = 0)
                THEN 'Stable-Other'
            -- Stable-Stable: both sides stablecoin
            WHEN sold_is_stable = 1 AND bought_is_stable = 1
                THEN 'Stable-Stable'
            -- Other-Other: neither SOL nor stablecoin on either side
            ELSE 'Other-Other'
        END as pair_category,
        -- Volume calculation with priority
        CASE
            WHEN sold_is_sol = 1 AND sold_usd > 0 THEN sold_usd
            WHEN bought_is_sol = 1 AND bought_usd > 0 THEN bought_usd
            WHEN sold_is_stable = 1 AND sold_usd > 0 THEN sold_usd
            WHEN bought_is_stable = 1 AND bought_usd > 0 THEN bought_usd
            WHEN sold_usd > 0 AND bought_usd > 0 THEN LEAST(sold_usd, bought_usd)
            ELSE 0
        END as volume_usd
    FROM trade_data
),

daily_volume AS (
    SELECT 
        block_date,
        pair_category,
        SUM(volume_usd) as volume_usd
    FROM categorized
    GROUP BY block_date, pair_category
),

daily_total AS (
    SELECT block_date, SUM(volume_usd) as total_volume_usd
    FROM daily_volume
    GROUP BY block_date
)

SELECT 
    dv.block_date,
    dv.pair_category,
    ROUND(dv.volume_usd, 2) as volume_usd,
    ROUND(dv.volume_usd * 100.0 / dt.total_volume_usd, 2) as volume_share_pct
FROM daily_volume dv
JOIN daily_total dt ON dv.block_date = dt.block_date
ORDER BY dv.block_date, dv.volume_usd DESC
]
