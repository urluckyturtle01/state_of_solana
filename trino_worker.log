[SQL: -- Description: Daily xStocks market cap, holders, and trading summary (volume/trades/avg trade) for a selected month

WITH mint_mapping AS (
 SELECT address, name, symbol, decimals, program
 FROM solana.rwa_tokens_mapping
 WHERE category='xStocks'
),

cte_price AS
(
select block_date, mint, avg(price_in_usd) as price_in_usd
from
solana.token_prices_1m
where block_date < CURRENT_DATE
  AND DATE_TRUNC('month', block_date) = DATE('2025-01-01')
  AND mint in (select address from mint_mapping)
group by 1,2
),

cte_mc AS
(
select s.block_date,
sum(post_balance*price_in_usd) as AUM,,
count(distinct owner) as unique_holders,
sum(post_balance*price_in_usd)/count(1) as avg_balance_per_holder_usd
from solana.account_spl_balances_agg s
JOIN mint_mapping m ON s.mint = m.address
left join cte_price p on s.mint=p.mint  and s.block_date=p.block_date
WHERE 1=1
  AND DATE_TRUNC('month', s.block_date) = DATE('2025-01-01')
  AND s.block_date>=date'2026-01-01'
  AND s.block_date < CURRENT_DATE
  and s.owner not in ('S7vYFFWH6BjJyEsdrPQpqpYTqLTrPRK6KW3VwsJuRaS','HmMxmEjTbpGqgDsCCmgNfQKCbeH6QcGe1xKn9UXqXFqk')
group by 1
),

cte_dex_trades AS
(
SELECT
    block_date,
    token_bought_mint,
    token_sold_mint,
    sum(token_bought_amount) as token_bought_amount,
    sum(token_sold_amount) as token_sold_amount,
    COUNT(1) AS trades
FROM solana.dex_trades
WHERE 1=1
AND (token_bought_mint in (select address from mint_mapping)
or token_sold_mint in (select address from mint_mapping))
  AND DATE_TRUNC('month',block_date) = DATE('2025-01-01')
  AND block_date>=date'2026-01-01'
  AND block_date < CURRENT_DATE
GROUP BY 1,2,3
),

cte_volume AS
(
select A.block_date,
sum(amount*price_in_usd) as volume, sum(trades) as trades,
sum(amount*price_in_usd)/sum(trades) as avg_trade_amount_usd
from
(select block_date,token_bought_mint as mint, token_bought_amount as amount, trades
from
cte_dex_trades
union all
select block_date,token_sold_mint as mint, token_sold_amount as amount, trades
from
cte_dex_trades
) A
join cte_price B on A.block_date=B.block_date and A.mint=B.mint
join mint_mapping C on A.mint=C.address
group by 1
)

select A.*,B.volume, B.trades,B.avg_trade_amount_usd
from
cte_mc A
left join cte_volume B
on A.block_date=B.block_date
order by 1 desc

]
