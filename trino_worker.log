[SQL: -- Description: Daily new token volume vs total volume
-- New token = token_bought_mint whose first trade is within the period
-- Excludes stablecoins and SOL from new token detection

/*
Logic:
- New token: token_bought_mint whose first trade date equals the current block_date
- Volume = MIN(sold_usd, bought_usd) when both > 0, else MAX
- Daily breakdown of new token volume vs total volume
*/

with excluded_pools as (
    select distinct pool_address
    from orca.whirlpool_config
    where config <> '2LecshUwdy9xi7meFgHtFJQNSKk4KdTrcpvaB56dP2NQ'
),

new_tokens as (
    select
        token_bought_mint as mint,
        min(block_date) as first_trade_date
    from solana.dex_trades
    where block_date < current_date
    group by 1
),

trade_rows as (
    select
        t.block_date,
        t.token_bought_mint,
        case when nt.first_trade_date = t.block_date then 'new_token' else 'existing_token' end as token_type,
        case when t.token_sold_mint = 'So11111111111111111111111111111111111111112'
            then t.token_sold_amount * coalesce(psol.price_in_usd, 0)
            else t.token_sold_amount * coalesce(ps.price_in_usd, 0)
        end as sold_usd,
        case when t.token_bought_mint = 'So11111111111111111111111111111111111111112'
            then t.token_bought_amount * coalesce(psol.price_in_usd, 0)
            else t.token_bought_amount * coalesce(pb.price_in_usd, 0)
        end as bought_usd
    from solana.dex_trades t
    left join solana.token_prices_1m psol on psol.mint = 'So11111111111111111111111111111111111111112'
        and date_trunc('minute', t.block_time) = psol.minute
    left join solana.token_prices_1m pb on t.token_bought_mint = pb.mint
        and date_trunc('minute', t.block_time) = pb.minute
        and pb.mint <> 'FATYxjEcXNYinyoR8SzHBKtzLz8qYRdUaHpxPS7dvirt'
    left join solana.token_prices_1m ps on t.token_sold_mint = ps.mint
        and date_trunc('minute', t.block_time) = ps.minute
        and ps.mint <> 'FATYxjEcXNYinyoR8SzHBKtzLz8qYRdUaHpxPS7dvirt'
    left join new_tokens nt on t.token_bought_mint = nt.mint
    where t.block_date >= CURRENT_DATE - INTERVAL '1' YEAR
      and DATE_TRUNC('month', t.block_date) = DATE('2026-03-01')
      and t.block_date < CURRENT_DATE
      and t.pool_address not in (select pool_address from excluded_pools)
),

daily_volume as (
    select
        block_date,
        token_bought_mint,
        token_type,
        case when sold_usd > 0 and bought_usd > 0 then least(sold_usd, bought_usd)
             else greatest(sold_usd, bought_usd)
        end as trade_volume_usd
    from trade_rows
)

select
    block_date,
    count(distinct case when token_type = 'new_token' then token_bought_mint end) as distinct_new_tokens,
    round(sum(trade_volume_usd), 2) as total_volume_usd,
    round(sum(case when token_type = 'new_token' then trade_volume_usd else 0 end), 2) as new_token_volume_usd,
    round(sum(case when token_type = 'new_token' then trade_volume_usd else 0 end) * 100.0
        / nullif(sum(trade_volume_usd), 0), 2) as new_token_volume_pct
from daily_volume
group by 1
order by 1 desc
]
