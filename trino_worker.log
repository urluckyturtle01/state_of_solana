[SQL: -- Description: Daily DEX fee and jito share vs total network
-- Shows both daily and cumulative DEX % of total fees and jito tips

WITH network_totals AS (
    SELECT 
        block_date,
        SUM(fee + priority_fee + COALESCE(jito_tips, 0)) / 1e9 as total_fee_sol,
        SUM(COALESCE(jito_tips, 0)) / 1e9 as total_jito_sol
    FROM solana.tx_metadata
    WHERE DATE_TRUNC('month', block_date) = DATE('2026-03-01')
      AND block_date < CURRENT_DATE
      AND success = true
    GROUP BY block_date
),

dex_totals AS (
    SELECT 
        block_date,
        SUM(fee + priority_fee + COALESCE(jito_tips, 0)) as dex_fee_sol,
        SUM(COALESCE(jito_tips, 0)) as dex_jito_sol
    FROM (
        SELECT DISTINCT block_date, block_slot, tx_index, txn_fee as fee, priority_fee, jito_tips
        FROM solana.dex_trades
        WHERE DATE_TRUNC('month', block_date) = DATE('2026-03-01')
          AND block_date < CURRENT_DATE
    )
    GROUP BY block_date
)

SELECT 
    n.block_date,
    ROUND(n.total_fee_sol, 4) as daily_network_fee_sol,
    ROUND(COALESCE(d.dex_fee_sol, 0), 4) as daily_dex_fee_sol,
    ROUND(COALESCE(d.dex_fee_sol, 0) * 100.0 / n.total_fee_sol, 2) as daily_dex_fee_pct,
    ROUND(n.total_jito_sol, 4) as daily_network_jito_sol,
    ROUND(COALESCE(d.dex_jito_sol, 0), 4) as daily_dex_jito_sol,
    ROUND(COALESCE(d.dex_jito_sol, 0) * 100.0 / NULLIF(n.total_jito_sol, 0), 2) as daily_dex_jito_pct,
    ROUND(SUM(n.total_fee_sol) OVER (ORDER BY n.block_date), 4) as cumulative_network_fee_sol,
    ROUND(SUM(COALESCE(d.dex_fee_sol, 0)) OVER (ORDER BY n.block_date), 4) as cumulative_dex_fee_sol,
    ROUND(SUM(n.total_jito_sol) OVER (ORDER BY n.block_date), 4) as cumulative_network_jito_sol,
    ROUND(SUM(COALESCE(d.dex_jito_sol, 0)) OVER (ORDER BY n.block_date), 4) as cumulative_dex_jito_sol
FROM network_totals n
LEFT JOIN dex_totals d ON n.block_date = d.block_date
ORDER BY n.block_date
]
