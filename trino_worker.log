            ('AvZZF1YaZDziPY2RCK4oJrRVrbN3mTD9NL24hPeaZeUj', 'syrupUSDC'),
            ('6FrrzDk5mQARGc1TDYoyVnSyRdds1t4PbtohCD6p3tgG', 'USX'),
            ('USD1ttGY1N17NEEHLmELoaybftRBUSErhqYiQzvEmuB', 'USD1')
    ) AS t(mint, name)
),

prices_deduped AS (
    SELECT mint, minute, MAX(price_in_usd) as price_in_usd
    FROM solana.token_prices_1m
    WHERE mint <> 'FATYxjEcXNYinyoR8SzHBKtzLz8qYRdUaHpxPS7dvirt'
    GROUP BY mint, minute
),

all_tokens AS (
    SELECT 
        t.block_date,
        t.block_time,
        x.mint,
        x.amount,
        t.signer
    FROM solana.dex_trades t
    CROSS JOIN UNNEST(
        ARRAY[t.token_bought_mint, t.token_sold_mint],
        ARRAY[t.token_bought_amount, t.token_sold_amount]
    ) AS x(mint, amount)
    WHERE DATE_TRUNC('month', t.block_date) = DATE('2026-03-01')
      AND t.block_date < CURRENT_DATE
      AND t.pool_address NOT IN (SELECT pool_address FROM excluded_pools)
),

daily_volume AS (
    SELECT 
        at.block_date,
        CASE 
            WHEN at.mint = 'So11111111111111111111111111111111111111112' THEN 'SOL'
            WHEN s.mint IS NOT NULL THEN 'Stablecoins'
            ELSE 'Other Tokens'
        END as token_category,
        SUM(at.amount * COALESCE(p.price_in_usd, 0)) as volume_usd
    FROM all_tokens at
    LEFT JOIN stablecoins s ON at.mint = s.mint
    LEFT JOIN prices_deduped p ON at.mint = p.mint
        AND DATE_TRUNC('minute', at.block_time) = p.minute
    GROUP BY 
        at.block_date,
        CASE 
            WHEN at.mint = 'So11111111111111111111111111111111111111112' THEN 'SOL'
            WHEN s.mint IS NOT NULL THEN 'Stablecoins'
            ELSE 'Other Tokens'
        END
),
daily_total AS (
    SELECT block_date, SUM(volume_usd) as total_volume_usd
    FROM daily_volume
    GROUP BY block_date
)

SELECT 
    dv.block_date,
    dv.token_category,
    ROUND(dv.volume_usd, 2) as volume_usd,
    ROUND(dv.volume_usd * 100.0 / dt.total_volume_usd, 2) as volume_share_pct
FROM daily_volume dv
JOIN daily_total dt ON dv.block_date = dt.block_date
ORDER BY dv.block_date, dv.volume_usd DESC

