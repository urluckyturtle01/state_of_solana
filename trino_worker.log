      AND t.block_date < CURRENT_DATE
      AND t.pool_address NOT IN (SELECT pool_address FROM excluded_pools)
)

SELECT
    tw.block_date,
    CASE WHEN ap.program_id IS NOT NULL THEN 'aggregator' ELSE 'non_aggregator' END AS source_type,
    COUNT(1) AS swaps,
    ROUND(SUM(
        CASE
            WHEN tw.sold_is_sol = 1 AND tw.sold_usd > 0 THEN tw.sold_usd
            WHEN tw.bought_is_sol = 1 AND tw.bought_usd > 0 THEN tw.bought_usd
            WHEN tw.sold_is_stable = 1 AND tw.sold_usd > 0 THEN tw.sold_usd
            WHEN tw.bought_is_stable = 1 AND tw.bought_usd > 0 THEN tw.bought_usd
            WHEN tw.sold_usd > 0 AND tw.bought_usd > 0 THEN LEAST(tw.sold_usd, tw.bought_usd)
            ELSE 0
        END
    ), 0) AS volume_usd
FROM trades_with_usd tw
LEFT JOIN aggregator_programs ap ON tw.outer_program = ap.program_id
GROUP BY 1, 2
ORDER BY 1, 4 DESC
