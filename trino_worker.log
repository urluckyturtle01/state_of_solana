        ('JUP5cHjnnCx2DppVsufsLrXs8EBZeEZzGtEK9Gdz6ow', 'Jupiter'),
        ('JUP5pEAZeHdHrLxh5UCwAbpjGwYKKoquCpda2hfP4u8', 'Jupiter'),
        ('6m2CDdhRgxpH4WjvdzxAYbGxwdGUz5MziiL5jek2kBma', 'OKX'),
        ('proVF4pMXVaYqmy4NjniPh4pqKNfMmsihgd4wdkCX3u', 'OKX'),
        ('T1TANpTeScyeqVzzgNViGDNrkQ6qHz9KrSBS4aNXvGT', 'Titan'),
        ('DF1ow4tspfHX9JwWJsAb9epbkA8hmpSEAtxXy1V27QBH', 'Dflow'),
        ('REALp6iMBDTctQqpmhBo4PumwJGcybbnDpxtax3ara3', 'Byreal Route')
    ) AS t(program_id, aggregator)
)

SELECT
    DATE('2026-03-01') as month,
