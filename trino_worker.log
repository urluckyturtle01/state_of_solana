    ROUND(SUM(jito_tips), 4) as total_jito_tips_sol,
    ROUND(SUM(priority_fee), 4) as total_priority_fee_sol,
    ROUND(SUM(volume_usd), 2) as total_volume_usd
FROM tx_level_metrics
