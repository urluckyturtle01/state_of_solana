[SQL: -- Description: Per-epoch REV and TEV for Solana (from 2025-01-01)
-- Epoch derived from block_slot: epoch = (block_slot - mod(block_slot, 432000)) / 432000
-- REV (Real Economic Value) = total fees + Jito tips
-- TEV (Total Economic Value) = REV + SOL issuance (inflation)
-- Fees from solana.blocks, Jito from solana.tx_metadata
-- Issuance from solana.block_rewards (Staking + Voting, distributed at epoch N+1)
-- USD conversion via solana.token_prices_1m

with epoch_fees as (
    select
        (block_slot - mod(block_slot, 432000)) / 432000 as epoch,
        min(block_date) as epoch_start_date,
        max(block_date) as epoch_end_date,
        (sum(successful_non_vote_transactions_fee + failed_non_vote_transactions_fee)
            + sum(successful_vote_transactions_fee + failed_vote_transactions_fee)) / 1e9 as total_fee_sol
    from solana.blocks
    where block_date >= date '2025-01-01'
      and block_date < current_date
    group by 1
),

epoch_jito as (
    select
        (block_slot - mod(block_slot, 432000)) / 432000 as epoch,
        sum(coalesce(jito_tips, 0)) / 1e9 as jito_tips_sol
    from solana.tx_metadata
    where block_date >= date '2025-01-01'
      and block_date < current_date
    group by 1
),

epoch_issuance as (
    select
        ((block_slot - mod(block_slot, 432000)) / 432000) - 1 as epoch,
        sum(lamports) / 1e9 as issuance_sol
    from solana.block_rewards
    where reward_type in ('Staking', 'Voting')
      and block_date >= date '2025-01-01'
    group by 1
),

epoch_sol_price as (
    select
        f.epoch,
        avg(p.avg_sol_price) as avg_sol_price
    from epoch_fees f
    join (
        select
            date_trunc('day', minute) as price_date,
            avg(price_in_usd) as avg_sol_price
        from solana.token_prices_1m
        where mint = 'So11111111111111111111111111111111111111112'
          and minute >= date '2025-01-01'
        group by 1
    ) p on p.price_date >= f.epoch_start_date
      and p.price_date <= f.epoch_end_date
    group by 1
)

select
    f.epoch,
    f.epoch_start_date,
    f.epoch_end_date,
    -- REV
    round(f.total_fee_sol + coalesce(j.jito_tips_sol, 0), 4) as epoch_rev_sol,
    round((f.total_fee_sol + coalesce(j.jito_tips_sol, 0)) * coalesce(p.avg_sol_price, 0), 2) as epoch_rev_usd,
    -- Issuance
    round(coalesce(i.issuance_sol, 0), 4) as epoch_issuance_sol,
    round(coalesce(i.issuance_sol, 0) * coalesce(p.avg_sol_price, 0), 2) as epoch_issuance_usd,
    -- TEV = REV + Issuance
    round(f.total_fee_sol + coalesce(j.jito_tips_sol, 0) + coalesce(i.issuance_sol, 0), 4) as epoch_tev_sol,
    round((f.total_fee_sol + coalesce(j.jito_tips_sol, 0) + coalesce(i.issuance_sol, 0)) * coalesce(p.avg_sol_price, 0), 2) as epoch_tev_usd,
    -- REV as % of TEV
    round((f.total_fee_sol + coalesce(j.jito_tips_sol, 0)) * 100.0
        / nullif(f.total_fee_sol + coalesce(j.jito_tips_sol, 0) + coalesce(i.issuance_sol, 0), 0), 2) as rev_pct_of_tev,
    -- Cumulative
    round(sum(f.total_fee_sol + coalesce(j.jito_tips_sol, 0)) over (order by f.epoch), 4) as cum_rev_sol,
    round(sum((f.total_fee_sol + coalesce(j.jito_tips_sol, 0)) * coalesce(p.avg_sol_price, 0)) over (order by f.epoch), 2) as cum_rev_usd,
    round(sum(f.total_fee_sol + coalesce(j.jito_tips_sol, 0) + coalesce(i.issuance_sol, 0)) over (order by f.epoch), 4) as cum_tev_sol,
    round(sum((f.total_fee_sol + coalesce(j.jito_tips_sol, 0) + coalesce(i.issuance_sol, 0)) * coalesce(p.avg_sol_price, 0)) over (order by f.epoch), 2) as cum_tev_usd
from epoch_fees f
 join epoch_jito j on f.epoch = j.epoch
 join epoch_issuance i on f.epoch = i.epoch
 join epoch_sol_price p on f.epoch = p.epoch
order by 1 desc
]
