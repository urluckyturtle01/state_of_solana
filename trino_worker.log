deduped_tvl AS (
    SELECT
        block_date,
        pool_address,
        total_tvl_usd,
        vault_mint_1,
        vault_mint_2
    FROM (
        SELECT
            block_date,
            pool_address,
            total_tvl_usd,
            vault_mint_1,
            vault_mint_2,
            ROW_NUMBER() OVER (PARTITION BY block_date, pool_address ORDER BY total_tvl_usd DESC) as rn
        FROM solana.dex_tvl
        WHERE DATE_TRUNC('month', block_date) = DATE('2026-03-01')
          AND block_date < CURRENT_DATE
    ) t
    WHERE rn = 1
),

filtered_pools AS (
    SELECT
        block_date,
        SUM(total_tvl_usd) as dex_tvl
    FROM deduped_tvl d
    WHERE NOT (
          COALESCE(d.total_tvl_usd, 0) > 100 * 1e6
          AND d.vault_mint_1 NOT IN (SELECT mint FROM cte_mints)
          AND d.vault_mint_2 NOT IN (SELECT mint FROM cte_mints)
      )
    GROUP BY 1
),

excluded_pools AS (
    SELECT DISTINCT pool_address
    FROM orca.whirlpool_config
    WHERE config <> '2LecshUwdy9xi7meFgHtFJQNSKk4KdTrcpvaB56dP2NQ'
