[SQL: -- Description: Daily Solana network cost and capacity metrics
-- Tracks total fees, priority fees, Jito tips, cost efficiency
-- Includes both successful and failed transactions (tx_metadata has non-vote only)
-- USD conversion via solana.token_prices_1m

with daily_metrics as (
    select
        block_date,
        count(*) as total_txns,
        sum(case when success = true then 1 else 0 end) as successful_txns,
        sum(case when success = false then 1 else 0 end) as failed_txns,
        -- base fee
        sum(fee) / 1e9 as total_base_fee_sol,
        sum(case when success = true then fee else 0 end) / 1e9 as successful_base_fee_sol,
        sum(case when success = false then fee else 0 end) / 1e9 as failed_base_fee_sol,
        -- priority fee
        sum(priority_fee) / 1e9 as total_priority_fee_sol,
        sum(case when success = true then priority_fee else 0 end) / 1e9 as successful_priority_fee_sol,
        sum(case when success = false then priority_fee else 0 end) / 1e9 as failed_priority_fee_sol,
        -- jito tips
        sum(coalesce(jito_tips, 0)) / 1e9 as total_jito_tips_sol,
        sum(case when success = true then coalesce(jito_tips, 0) else 0 end) / 1e9 as successful_jito_tips_sol,
        sum(case when success = false then coalesce(jito_tips, 0) else 0 end) / 1e9 as failed_jito_tips_sol,
        -- total cost
        sum(fee + priority_fee + coalesce(jito_tips, 0)) / 1e9 as total_cost_sol,
        sum(case when success = true then fee + priority_fee + coalesce(jito_tips, 0) else 0 end) / 1e9 as successful_cost_sol,
        sum(case when success = false then fee + priority_fee + coalesce(jito_tips, 0) else 0 end) / 1e9 as failed_cost_sol,
        -- per-txn stats
        avg((fee + priority_fee + coalesce(jito_tips, 0)) / 1e9) as avg_cost_per_txn_sol,
        approx_percentile((fee + priority_fee + coalesce(jito_tips, 0)) / 1e9, 0.5) as median_cost_per_txn_sol,
        stddev((fee + priority_fee + coalesce(jito_tips, 0)) / 1e9) as stddev_cost_per_txn_sol,
        max((fee + priority_fee + coalesce(jito_tips, 0)) / 1e9) as max_cost_per_txn_sol
    from solana.tx_metadata
    where DATE_TRUNC('month', block_date) = DATE('2026-03-01')
      and block_date < current_date
    group by 1
),

sol_price as (
    select
        date_trunc('day', minute) as price_date,
        avg(price_in_usd) as avg_sol_price
    from solana.token_prices_1m
    where mint = 'So11111111111111111111111111111111111111112'
      and DATE_TRUNC('month', minute) = DATE('2026-03-01')
      and minute < current_date
    group by 1
)

select
    m.block_date,
    -- txns
    m.total_txns,
    m.successful_txns,
    m.failed_txns,
    round(m.failed_txns * 100.0 / nullif(m.total_txns, 0), 2) as failure_rate_pct,
    -- total fee (success vs failed) in SOL + USD
    round(m.successful_cost_sol, 4) as successful_fee_sol,
    round(m.failed_cost_sol, 4) as failed_fee_sol,
    round(m.successful_cost_sol * coalesce(p.avg_sol_price, 0), 2) as successful_fee_usd,
    round(m.failed_cost_sol * coalesce(p.avg_sol_price, 0), 2) as failed_fee_usd,
    -- failed % by fee type
    round(m.failed_base_fee_sol * 100.0 / nullif(m.total_base_fee_sol, 0), 2) as failed_base_fee_pct,
    round(m.failed_priority_fee_sol * 100.0 / nullif(m.total_priority_fee_sol, 0), 2) as failed_priority_fee_pct,
    round(m.failed_jito_tips_sol * 100.0 / nullif(m.total_jito_tips_sol, 0), 2) as failed_jito_tips_pct,
    round(m.failed_cost_sol * 100.0 / nullif(m.total_cost_sol, 0), 2) as failed_total_fee_pct,
    -- max successful and failed fee
    round(max(m.successful_cost_sol) over (), 4) as max_successful_fee_sol,
    round(max(m.failed_cost_sol) over (), 4) as max_failed_fee_sol,
    round(max(m.successful_cost_sol * coalesce(p.avg_sol_price, 0)) over (), 2) as max_successful_fee_usd,
    round(max(m.failed_cost_sol * coalesce(p.avg_sol_price, 0)) over (), 2) as max_failed_fee_usd,
    -- avg, median, stddev, max cost per txn (SOL + USD)
    round(m.avg_cost_per_txn_sol, 8) as avg_cost_per_txn_sol,
    round(m.median_cost_per_txn_sol, 8) as median_cost_per_txn_sol,
    round(m.stddev_cost_per_txn_sol, 8) as stddev_cost_per_txn_sol,
    round(m.max_cost_per_txn_sol, 8) as max_cost_per_txn_sol,
    round(m.avg_cost_per_txn_sol * coalesce(p.avg_sol_price, 0), 6) as avg_cost_per_txn_usd,
    round(m.median_cost_per_txn_sol * coalesce(p.avg_sol_price, 0), 6) as median_cost_per_txn_usd,
    round(m.stddev_cost_per_txn_sol * coalesce(p.avg_sol_price, 0), 6) as stddev_cost_per_txn_usd,
    round(m.max_cost_per_txn_sol * coalesce(p.avg_sol_price, 0), 6) as max_cost_per_txn_usd
from daily_metrics m
left join sol_price p on m.block_date = p.price_date
order by 1 desc
]
