SELECT
    d.block_date,
    ROUND(SUM(CASE
        WHEN (d.vault_mint_1 = 'So11111111111111111111111111111111111111112' AND s2.mint IS NOT NULL)
          OR (s1.mint IS NOT NULL AND d.vault_mint_2 = 'So11111111111111111111111111111111111111112')
        THEN d.total_tvl_usd ELSE 0
    END), 2) as sol_stable_tvl,
    ROUND(SUM(CASE
        WHEN s1.mint IS NOT NULL AND s2.mint IS NOT NULL
             AND d.vault_mint_1 <> 'So11111111111111111111111111111111111111112'
             AND d.vault_mint_2 <> 'So11111111111111111111111111111111111111112'
        THEN d.total_tvl_usd ELSE 0
    END), 2) as stable_stable_tvl,
    ROUND(SUM(CASE
        WHEN NOT (
            (d.vault_mint_1 = 'So11111111111111111111111111111111111111112' AND s2.mint IS NOT NULL)
            OR (s1.mint IS NOT NULL AND d.vault_mint_2 = 'So11111111111111111111111111111111111111112')
            OR (s1.mint IS NOT NULL AND s2.mint IS NOT NULL)
        )
        THEN d.total_tvl_usd ELSE 0
    END), 2) as other_tvl
FROM deduped_tvl d
LEFT JOIN stablecoins s1 ON d.vault_mint_1 = s1.mint
LEFT JOIN stablecoins s2 ON d.vault_mint_2 = s2.mint
WHERE NOT (
      COALESCE(d.total_tvl_usd, 0) > 100 * 1e6
      AND d.vault_mint_1 NOT IN (SELECT mint FROM cte_mints)
      AND d.vault_mint_2 NOT IN (SELECT mint FROM cte_mints)
  )
GROUP BY 1
ORDER BY 1
