[SQL: -- Description: Daily volume by signer transaction count distribution
-- Shows how much volume is generated by traders based on their transaction frequency per day
-- Volume priority: SOL side → Stablecoin side → MIN(both sides)

/*
Logic:
- Groups signers by transaction count per day (1 txn, 2-5 txns, 6-10 txns, etc.)
- Volume priority: SOL > Stablecoin > MIN(both)
- Shows daily breakdown of volume by trader frequency
*/

WITH excluded_pools AS (
    SELECT DISTINCT pool_address
    FROM orca.whirlpool_config
    WHERE config <> '2LecshUwdy9xi7meFgHtFJQNSKk4KdTrcpvaB56dP2NQ'
),

stablecoins AS (
    SELECT mint FROM (VALUES
        ('EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v'),
