WITH mint_mapping AS (
    SELECT
        address AS mint,
        CASE category
            WHEN 'Stablecoin' THEN 'stablecoins'
            WHEN 'YBT' THEN 'yield_bearing_tokens'
            WHEN 'xStocks' THEN 'xstocks'
            WHEN 'Tokenized Funds' THEN 'tokenized_funds'
            WHEN 'Tokenized Commodities' THEN 'tokenized_commodities'
        END AS category
    FROM solana.rwa_tokens_mapping
    WHERE category IN ('Stablecoin', 'YBT', 'xStocks', 'Tokenized Funds', 'Tokenized Commodities')
      AND address NOT IN (
        'A94X2fRy3wydNShU4dRaDyap2UuoeWJGWyATtyp61WZf',
        'dngKhBQM3BGvsDHKhrLnjvRKfY5Q7gEnYGToj9Lk8rk',
        'Crn4x1Y2HUKko7ox2EZMT6N2t2ZyH7eKtwkBGVnhEq1g',
        'FrBfWJ4qE5sCzKm3k3JaAtqZcXUh4LvJygDeketsrsH4',
        'FtgGSFADXBtroxq8VCausXRr2of47QBf5AS1NtZCu4GD'
      )
),

cte_price AS (
    SELECT
        block_date,
        mint,
        AVG(price_in_usd) AS price_in_usd
    FROM solana.token_prices_1m
    WHERE block_date < CURRENT_DATE
      AND DATE_TRUNC('month', block_date) = DATE('2026-01-01')
      AND mint IN (SELECT mint FROM mint_mapping)
      AND price_in_usd < 5000
    GROUP BY 1, 2
),

cte_supply AS (
    SELECT
        m.category,
        s.block_date,
        SUM(s.post_balance * COALESCE(p.price_in_usd, 0)) AS marketcap,
        COUNT(DISTINCT s.owner) AS unique_holders
    FROM solana.account_spl_balances_agg s
    JOIN mint_mapping m
        ON s.mint = m.mint
    LEFT JOIN cte_price p
        ON s.mint = p.mint
        AND s.block_date = p.block_date
    WHERE DATE_TRUNC('month', s.block_date) = DATE('2026-01-01')
      AND s.block_date >= DATE('2026-01-01')
      AND s.block_date < CURRENT_DATE
    GROUP BY 1, 2
),

cte_base AS (
    SELECT DISTINCT
        m.category,
        s.block_date
    FROM solana.account_spl_balances_agg s
    JOIN mint_mapping m
        ON s.mint = m.mint
    WHERE DATE_TRUNC('month', s.block_date) = DATE('2026-01-01')
      AND s.block_date >= DATE('2026-01-01')
      AND s.block_date < CURRENT_DATE
)

SELECT
    base.block_date,
    base.category,
    s.marketcap,
    s.unique_holders
FROM cte_base base
LEFT JOIN cte_supply s
    ON s.category = base.category
    AND s.block_date = base.block_date
ORDER BY base.block_date DESC, base.category
