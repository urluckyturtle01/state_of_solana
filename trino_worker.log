    ROUND(dv.volume_usd * 100.0 / dt.total_volume_usd, 2) as volume_share_pct
FROM daily_volume dv
JOIN daily_total dt ON dv.block_date = dt.block_date
ORDER BY dv.block_date, dv.volume_usd DESC
]
