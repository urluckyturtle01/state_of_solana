[SQL: -- Description: Daily category-level overview metrics for all RWA categories
-- Outputs at `block_date` + `category` level (daily time series per category)
WITH mint_mapping AS (
    -- Map each RWA mint to a normalized "category" label used by the dashboard
    SELECT
        address AS mint,
        decimals,
        program,
        CASE category
            WHEN 'Stablecoin' THEN 'stablecoins'
            WHEN 'YBT' THEN 'yield_bearing_tokens'
            WHEN 'xStocks' THEN 'xstocks'
            WHEN 'Tokenized Funds' THEN 'tokenized_funds'
            WHEN 'Tokenized Commodities' THEN 'tokenized_commodities'
        END AS category
    FROM solana.rwa_tokens_mapping
    WHERE category IN ('Stablecoin', 'YBT', 'xStocks', 'Tokenized Funds', 'Tokenized Commodities')
      AND address not in (
        'A94X2fRy3wydNShU4dRaDyap2UuoeWJGWyATtyp61WZf',
        'dngKhBQM3BGvsDHKhrLnjvRKfY5Q7gEnYGToj9Lk8rk',
        'Crn4x1Y2HUKko7ox2EZMT6N2t2ZyH7eKtwkBGVnhEq1g',
        'FrBfWJ4qE5sCzKm3k3JaAtqZcXUh4LvJygDeketsrsH4',
        'FtgGSFADXBtroxq8VCausXRr2of47QBf5AS1NtZCu4GD'
      )
),

cte_price AS (
    SELECT
        block_date,
        mint,
        avg(price_in_usd) AS price_in_usd
    FROM solana.token_prices_1m
    WHERE block_date < CURRENT_DATE
      AND DATE_TRUNC('month', block_date) = DATE('2026-03-01')
      AND mint IN (SELECT mint FROM mint_mapping)
      and price_in_usd<5000
    GROUP BY 1, 2
),

cte_supply AS (
    -- Market cap + holders from account_spl_balances_agg for consistent category-level aggregation
    SELECT
        m.category AS category,
        s.block_date AS block_date,
        SUM(s.post_balance * COALESCE(p.price_in_usd, 0)) AS marketcap,
        COUNT(DISTINCT s.owner) AS unique_holders
    FROM solana.account_spl_balances_agg s
    JOIN mint_mapping m
        ON s.mint = m.mint
    LEFT JOIN cte_price p
        ON s.mint = p.mint
        AND s.block_date = p.block_date
    WHERE DATE_TRUNC('month', s.block_date) = DATE('2026-03-01')
      AND s.block_date >= DATE('2026-01-01')
      AND s.block_date < CURRENT_DATE
    GROUP BY 1, 2
),

cte_dex_trades AS (
    -- Same structure as section daily summaries:
    -- group by (block_date, bought_mint, sold_mint) and use COUNT(1) for trades
    SELECT
        block_date,
        token_bought_mint,
        token_sold_mint,
        sum(token_bought_amount) as token_bought_amount,
        sum(token_sold_amount) as token_sold_amount,
        COUNT(1) AS trades
    FROM solana.dex_trades
    WHERE 1=1
      AND (token_bought_mint IN (SELECT mint FROM mint_mapping)
        OR token_sold_mint IN (SELECT mint FROM mint_mapping))
      AND DATE_TRUNC('month', block_date) = DATE('2026-03-01')
      AND block_date >= DATE('2026-01-01')
      AND block_date < CURRENT_DATE
    GROUP BY 1,2,3
),

cte_volume AS (
    -- Compute USD volume + trades count by category
    -- (trades are summed over both legs, same as the daily_summary pattern)
    SELECT
        A.block_date,
        A.category,
        SUM(A.amount * B.price_in_usd) AS dex_volume,
        SUM(A.trades) AS dex_trades
    FROM (
        SELECT
            dt.block_date,
            mm.category AS category,
            dt.token_bought_mint AS mint,
            dt.token_bought_amount AS amount,
            dt.trades AS trades
        FROM cte_dex_trades dt
        JOIN mint_mapping mm ON dt.token_bought_mint = mm.mint

        UNION ALL

        SELECT
            dt.block_date,
            mm.category AS category,
            dt.token_sold_mint AS mint,
            dt.token_sold_amount AS amount,
            dt.trades AS trades
        FROM cte_dex_trades dt
        JOIN mint_mapping mm ON dt.token_sold_mint = mm.mint
    ) A
    JOIN cte_price B
        ON A.block_date = B.block_date
        AND A.mint = B.mint
    GROUP BY 1, 2
),

transfer_raw AS (
    -- Transfer + P2P transfer volume in token units (normalized by decimals)
    SELECT
        a.block_date,
        a.mint,
        a.volume_raw,
        a.p2p_volume_raw
    FROM (
        SELECT
            sp.block_date,
            sp.mint,
            SUM(sp.args.amount) AS volume_raw,
            SUM(CASE WHEN sp.outer_program = 'TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA' THEN sp.args.amount END) AS p2p_volume_raw
        FROM solana.spl_token sp
        WHERE DATE_TRUNC('month', sp.block_date) = DATE('2026-03-01')
          AND sp.block_date >= DATE('2026-01-01')
          AND sp.block_date < CURRENT_DATE
          AND sp.instruction_type IN ('Transfer', 'TransferChecked')
          AND sp.mint IN (SELECT mint FROM mint_mapping WHERE program = 'spl_token')
        GROUP BY 1, 2

        UNION ALL

        SELECT
            sp22.block_date,
            sp22.mint,
            SUM(sp22.args.amount) AS volume_raw,
            SUM(CASE WHEN sp22.outer_program IS NULL THEN sp22.args.amount END) AS p2p_volume_raw
        FROM solana.spl_token_22 sp22
        WHERE DATE_TRUNC('month', sp22.block_date) = DATE('2026-03-01')
          AND sp22.block_date >= DATE('2026-01-01')
          AND sp22.block_date < CURRENT_DATE
          AND sp22.instruction_type IN ('Transfer', 'TransferChecked')
          AND sp22.mint IN (SELECT mint FROM mint_mapping WHERE program = 'spl_token_22')
        GROUP BY 1, 2
    ) a
),

cte_transfer AS (
    SELECT
        m.category AS category,
        tr.block_date AS block_date,
        SUM(tr.volume_raw / pow(10, m.decimals)) AS transfer_volume,
        SUM(tr.p2p_volume_raw / pow(10, m.decimals)) AS p2p_transfer_volume
    FROM transfer_raw tr
    JOIN mint_mapping m
        ON tr.mint = m.mint
    GROUP BY 1, 2
)

,
cte_base AS (
    -- Daily scaffold for (block_date, category)
    SELECT DISTINCT
        m.category AS category,
        s.block_date AS block_date
    FROM solana.account_spl_balances_agg s
    JOIN mint_mapping m
        ON s.mint = m.mint
    WHERE DATE_TRUNC('month', s.block_date) = DATE('2026-03-01')
      AND s.block_date >= DATE('2026-01-01')
      AND s.block_date < CURRENT_DATE
)

SELECT
    base.block_date AS block_date,
    base.category AS category,
    s.marketcap,
    s.unique_holders,
    v.dex_volume,
    v.dex_trades,
    tr.transfer_volume,
    tr.p2p_transfer_volume
FROM cte_base base
LEFT JOIN cte_supply s
    ON s.category = base.category
    AND s.block_date = base.block_date
LEFT JOIN cte_volume v
