            CASE 
                -- Priority 1: If SOL is bought, use SOL amount * price
                WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112'
                THEN t.token_bought_amount * COALESCE(psol.price_in_usd, 0)
                -- Priority 2: If SOL is sold, use SOL amount * price
                WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112'
                THEN t.token_sold_amount * COALESCE(psol.price_in_usd, 0)
                -- Priority 3: If stablecoin is bought, use stablecoin amount * price
                WHEN sb.mint IS NOT NULL
                THEN t.token_bought_amount * COALESCE(pb.price_in_usd, 0)
                -- Priority 4: If stablecoin is sold, use stablecoin amount * price
                WHEN ss.mint IS NOT NULL
                THEN t.token_sold_amount * COALESCE(ps.price_in_usd, 0)
                -- Priority 5: Neither has SOL or stablecoin, use bought token price
                ELSE t.token_bought_amount * COALESCE(pb.price_in_usd, 0)
            END
        ) as volume_usd
    FROM solana.dex_trades t
    LEFT JOIN stablecoins ss ON t.token_sold_mint = ss.mint
    LEFT JOIN stablecoins sb ON t.token_bought_mint = sb.mint
    LEFT JOIN solana.token_prices_1m psol ON psol.mint = 'So11111111111111111111111111111111111111112'
        AND DATE_TRUNC('minute', t.block_time) = psol.minute
    LEFT JOIN solana.token_prices_1m pb ON t.token_bought_mint = pb.mint
        AND DATE_TRUNC('minute', t.block_time) = pb.minute
        AND pb.mint <> 'FATYxjEcXNYinyoR8SzHBKtzLz8qYRdUaHpxPS7dvirt'
    LEFT JOIN solana.token_prices_1m ps ON t.token_sold_mint = ps.mint
        AND DATE_TRUNC('minute', t.block_time) = ps.minute
        AND ps.mint <> 'FATYxjEcXNYinyoR8SzHBKtzLz8qYRdUaHpxPS7dvirt'
    WHERE DATE_TRUNC('month', t.block_date) = DATE('2025-03-01')
      AND t.block_date < CURRENT_DATE
      AND t.pool_address NOT IN (SELECT pool_address FROM excluded_pools)
    GROUP BY 1, 2
)

SELECT 
    block_date,
    pool_category,
    ROUND(volume_usd, 2) as daily_volume_usd,
    ROUND(SUM(volume_usd) OVER (PARTITION BY pool_category ORDER BY block_date), 2) as cumulative_volume_usd
FROM categorized_trades
ORDER BY block_date, daily_volume_usd DESC
 LIMIT 10000]
