        ON DATE_TRUNC('minute', t.block_time) = psol.minute
    LEFT JOIN prices_deduped pb 
        ON t.token_bought_mint = pb.mint
        AND DATE_TRUNC('minute', t.block_time) = pb.minute
        AND t.token_bought_mint <> 'So11111111111111111111111111111111111111112'
    LEFT JOIN prices_deduped ps 
        ON t.token_sold_mint = ps.mint
        AND DATE_TRUNC('minute', t.block_time) = ps.minute
        AND t.token_sold_mint <> 'So11111111111111111111111111111111111111112'
    WHERE DATE_TRUNC('month', t.block_date) = DATE('2026-02-01')
      AND t.block_date < CURRENT_DATE
      AND t.pool_address NOT IN (SELECT pool_address FROM excluded_pools)
),

trader_volume AS (
    SELECT 
        block_date,
        signer,
        COUNT(DISTINCT (block_slot, tx_index)) as txn_count,
        SUM(
            CASE
                WHEN sold_is_sol = 1 AND sold_usd > 0 THEN sold_usd
                WHEN bought_is_sol = 1 AND bought_usd > 0 THEN bought_usd
                WHEN sold_is_stable = 1 AND sold_usd > 0 THEN sold_usd
                WHEN bought_is_stable = 1 AND bought_usd > 0 THEN bought_usd
                WHEN sold_usd > 0 AND bought_usd > 0 THEN LEAST(sold_usd, bought_usd)
                ELSE 0
            END
        ) as total_volume_usd
    FROM trade_rows
    GROUP BY block_date, signer
),

trader_buckets AS (
    SELECT 
        block_date,
        signer,
        txn_count,
        total_volume_usd,
        CASE 
            WHEN txn_count = 1 THEN '1_txn'
            WHEN txn_count BETWEEN 2 AND 5 THEN '2-5_txns'
            WHEN txn_count BETWEEN 6 AND 10 THEN '6-10_txns'
            WHEN txn_count BETWEEN 11 AND 20 THEN '11-20_txns'
            WHEN txn_count BETWEEN 21 AND 50 THEN '21-50_txns'
            ELSE '51+_txns'
        END as frequency_bucket
    FROM trader_volume
)

SELECT 
    block_date,
    frequency_bucket,
    COUNT(DISTINCT signer) as trader_count,
    ROUND(SUM(total_volume_usd), 2) as daily_volume_usd,
    ROUND(AVG(total_volume_usd), 2) as avg_volume_per_trader_usd,
    ROUND(SUM(txn_count), 0) as total_txns
FROM trader_buckets
GROUP BY block_date, frequency_bucket
ORDER BY 
    block_date DESC,
    CASE frequency_bucket
        WHEN '1_txn' THEN 1
        WHEN '2-5_txns' THEN 2
        WHEN '6-10_txns' THEN 3
        WHEN '11-20_txns' THEN 4
        WHEN '21-50_txns' THEN 5
        WHEN '51+_txns' THEN 6
    END
]
