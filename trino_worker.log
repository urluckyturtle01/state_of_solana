[SQL: -- Description: DEX volume by stablecoin from rwa_tokens_mapping
-- Filters dex_trades to trades involving stablecoin mints in mapping
-- Volume: token amount normalized by token price

/*
Logic:
- Read stablecoin mint universe from solana.rwa_tokens_mapping
- Capture trades where either bought or sold mint is a stablecoin mint
- Convert both sides into a single mint/amount stream and multiply by daily avg token price
- Group by block_date and stablecoin symbol
- Outputs: block_date, mint, volume, swaps
*/

WITH mint_mapping AS (
    SELECT address, name, symbol, decimals, program
    FROM solana.rwa_tokens_mapping
    WHERE category='YBT'
),

cte_dex_trades as
(
SELECT
    block_date,
    token_bought_mint,
    token_sold_mint,
    sum(token_bought_amount) as token_bought_amount,
    sum(token_sold_amount) as token_sold_amount,
    COUNT(1) AS swaps
FROM solana.dex_trades
WHERE 1=1
AND (token_bought_mint in (select address from mint_mapping)
or token_sold_mint in (select address from mint_mapping))
 AND DATE_TRUNC('month', block_date) = DATE('2026-03-01')
AND block_date >= DATE('2026-01-01')
 AND block_date < CURRENT_DATE
GROUP BY 1,2,3
)

select A.block_date, C.symbol as mint, sum(amount*price_in_usd) as volume, sum(swaps) as swaps
from
(select block_date,token_bought_mint as mint, token_bought_amount as amount, swaps
from
cte_dex_trades
union all
select block_date,token_sold_mint as mint, token_sold_amount as amount, swaps
from
cte_dex_trades
) A
join (select block_date, mint,avg(price_in_usd) as price_in_usd from solana.token_prices_1m
where mint in (select address from mint_mapping)
group by 1,2) B
on A.block_date=B.block_date and A.mint=B.mint
join mint_mapping C on A.mint=C.address
group by 1,2
order by 1 desc, 3 Desc
]
