-- Tracks transfer activity for stablecoins across SPL Token and SPL Token-2022 programs

/*
Logic:
- Union data from spl_token and spl_token_22 tables
- Calculate P2P transfers (direct transfers without program interaction)
- Join with supply data to calculate velocity metrics
- Use decimals from rwa_tokens_mapping for normalization
- Metrics: volume, P2P volume, transfer counts, average sizes, velocity
*/

WITH mint_mapping AS (
select address,name,symbol,decimals,program
from solana.rwa_tokens_mapping
where category='Stablecoin'
and address not in ('A94X2fRy3wydNShU4dRaDyap2UuoeWJGWyATtyp61WZf','dngKhBQM3BGvsDHKhrLnjvRKfY5Q7gEnYGToj9Lk8rk',
