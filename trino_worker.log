-- Shows daily volume and share across token categories by unpivoting bought and sold tokens

/*
Logic:
- UNNEST bought and sold tokens in a single table scan
- Categorize tokens into: Stablecoins, SOL, Other
- Calculate daily volume in USD for each category
- Show daily market share percentage
*/

WITH excluded_pools AS (
    SELECT DISTINCT pool_address
    FROM orca.whirlpool_config
    WHERE config <> '2LecshUwdy9xi7meFgHtFJQNSKk4KdTrcpvaB56dP2NQ'
),

stablecoins AS (
    SELECT mint, name FROM (
        VALUES 
            ('EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v', 'USDC'),
            ('Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB', 'USDT'),
