 FROM solana.rwa_tokens_mapping
 WHERE category='Tokenized Funds'
),

cte_price AS
(
select block_date, mint, avg(price_in_usd) as price_in_usd
from
solana.token_prices_1m
where block_date < CURRENT_DATE
  AND mint in (select address from mint_mapping)
group by 1,2
)


select block_date,
 s.mint as mint_address,
    m.symbol as mint,
sum(post_balance) as supply, 
sum(post_balance*price_in_usd) as marketcap, 
count(1) as holders,
sum(post_balance*price_in_usd)/count(1) as avg_balance_per_holder_usd
from solana.account_spl_balances_agg s
JOIN mint_mapping m ON s.mint = m.address
join cte_price p on s.mint=p.mint and s.block_date=p.block_date
WHERE 1=1
  AND DATE_TRUNC('month', s.block_date) = DATE('2026-03-01')
  AND s.block_date >= DATE('2026-01-01')
  AND s.block_date < CURRENT_DATE
group by 1,2,3
ORDER BY 1 DESC, 5 DESC
]
(Background on this error at: https://sqlalche.me/e/20/f405)
