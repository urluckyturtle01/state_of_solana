trader_buckets AS (
    SELECT 
        block_date,
        signer,
        txn_count,
        total_volume_usd,
        CASE 
            WHEN txn_count = 1 THEN '1_txn'
            WHEN txn_count BETWEEN 2 AND 5 THEN '2-5_txns'
            WHEN txn_count BETWEEN 6 AND 10 THEN '6-10_txns'
            WHEN txn_count BETWEEN 11 AND 20 THEN '11-20_txns'
            WHEN txn_count BETWEEN 21 AND 50 THEN '21-50_txns'
            ELSE '51+_txns'
        END as frequency_bucket
    FROM trader_volume
)

SELECT 
    block_date,
    frequency_bucket,
    COUNT(DISTINCT signer) as trader_count,
    ROUND(SUM(total_volume_usd), 2) as daily_volume_usd,
    ROUND(AVG(total_volume_usd), 2) as avg_volume_per_trader_usd,
    ROUND(SUM(txn_count), 0) as total_txns
FROM trader_buckets
GROUP BY block_date, frequency_bucket
ORDER BY 
    block_date DESC,
    CASE frequency_bucket
