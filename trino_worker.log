[SQL: -- Description: Daily volume breakdown by pair category (non-overlapping)
-- Categories: SOL-Stable, SOL-Other, Stable-Other, Other-Other
-- Volume priority: SOL side → Stablecoin side → MIN(both sides)

/*
Logic:
- Categorize trades by pair type (no overlap):
  - SOL-Stable: SOL paired with stablecoin
  - SOL-Other: SOL paired with non-stable token
  - Stable-Other: Stablecoin paired with non-SOL, non-stable token
  - Other-Other: Neither SOL nor stablecoin on either side
- Volume priority: SOL > Stablecoin > MIN(both)
- Show daily breakdown and share
*/

WITH excluded_pools AS (
    SELECT DISTINCT pool_address
    FROM orca.whirlpool_config
    WHERE config <> '2LecshUwdy9xi7meFgHtFJQNSKk4KdTrcpvaB56dP2NQ'
),

stablecoins AS (
    SELECT mint FROM (
        VALUES 
            ('EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v'),
            ('Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB'),
