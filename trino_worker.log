FROM cte_base base
LEFT JOIN cte_supply s
    ON s.category = base.category
    AND s.block_date = base.block_date
LEFT JOIN cte_volume v
    ON v.category = base.category
    AND v.block_date = base.block_date
LEFT JOIN cte_transfer tr
    ON tr.category = base.category
    AND tr.block_date = base.block_date
ORDER BY base.block_date DESC, base.category

