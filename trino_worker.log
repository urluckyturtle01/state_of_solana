[SQL: -- Description: Daily active traders with new trader % and cumulative new traders
-- New trader = signer whose first-ever dex trade is on that day

/*
Logic:
- Find each signer's first dex trade date
- Count daily active traders and daily new traders (first txn that day)
- Calculate new trader % of active traders
- Cumulative new traders over time
*/

WITH first_trade AS (
    SELECT signer, MIN(block_date) as first_trade_date
    FROM solana.dex_trades
    WHERE block_date < CURRENT_DATE
    GROUP BY 1
),
daily_stats AS (
    SELECT
        t.block_date,
        COUNT(DISTINCT t.signer) as active_traders,
        COUNT(DISTINCT CASE WHEN f.first_trade_date = t.block_date THEN t.signer END) as new_traders
    FROM solana.dex_trades t
    LEFT JOIN first_trade f ON t.signer = f.signer
    WHERE t.block_date >= CURRENT_DATE - INTERVAL '1' YEAR
      AND DATE_TRUNC('month', t.block_date) = DATE('2025-03-01')
      AND t.block_date < CURRENT_DATE
    GROUP BY 1
)

SELECT
    block_date,
    active_traders,
    new_traders,
    ROUND(new_traders * 100.0 / NULLIF(active_traders, 0), 2) as new_trader_pct,
    SUM(new_traders) OVER (ORDER BY block_date) as cumulative_new_traders
FROM daily_stats
ORDER BY block_date
]
