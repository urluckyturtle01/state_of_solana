filtered_pools AS (
    SELECT
        block_date,
        SUM(total_tvl_usd) as dex_tvl
    FROM solana.dex_tvl d
    WHERE DATE_TRUNC('month', block_date) = DATE('2025-12-01')
      AND block_date < CURRENT_DATE
      AND NOT (
          COALESCE(d.total_tvl_usd, 0) > 100 * 1e6
          AND d.vault_mint_1 NOT IN (SELECT mint FROM cte_mints)
          AND d.vault_mint_2 NOT IN (SELECT mint FROM cte_mints)
      )
    GROUP BY 1
),

excluded_pools AS (
    SELECT DISTINCT pool_address
    FROM orca.whirlpool_config
    WHERE config <> '2LecshUwdy9xi7meFgHtFJQNSKk4KdTrcpvaB56dP2NQ'
),

stablecoins AS (
