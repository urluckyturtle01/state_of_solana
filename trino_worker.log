    from solana.tx_metadata
    where block_date >= date '2025-01-01'
      and block_date < current_date
    group by 1
),

-- Staking + Voting rewards distributed at epoch N+1 for epoch N
epoch_inflation_rewards as (
    select
        ((block_slot - mod(block_slot, 432000)) / 432000) - 1 as epoch,
        sum(case when reward_type = 'Staking' then lamports else 0 end) / 1e9 as staking_rewards_sol,
        sum(case when reward_type = 'Voting' then lamports else 0 end) / 1e9 as voting_rewards_sol
