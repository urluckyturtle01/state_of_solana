[SQL: -- Description: Aggregator vs Non-Aggregator DEX volume
-- Aggregator: outer_program in aggregator_programs (Jupiter, OKX, etc.)
-- Non-Aggregator: outer_program not in aggregator_programs
-- Volume priority: SOL side → Stablecoin side → MIN(both sides)

/*
Logic:
- Aggregator volume: trades where outer_program is known aggregator
- Non-aggregator volume: all other DEX trades
- Volume priority: SOL > Stablecoin > MIN(both)
- Outputs: block_date, source_type, swaps, volume_usd
*/

WITH excluded_pools AS (
    SELECT DISTINCT pool_address
