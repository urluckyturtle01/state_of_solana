program_volume AS (
    SELECT
        sub.block_date,
        pn.program,
        pn.program_name,
        SUM(
            CASE
                WHEN sub.sold_is_sol = 1 AND sub.sold_usd > 0 THEN sub.sold_usd
                WHEN sub.bought_is_sol = 1 AND sub.bought_usd > 0 THEN sub.bought_usd
                WHEN sub.sold_is_stable = 1 AND sub.sold_usd > 0 THEN sub.sold_usd
                WHEN sub.bought_is_stable = 1 AND sub.bought_usd > 0 THEN sub.bought_usd
                WHEN sub.sold_usd > 0 AND sub.bought_usd > 0 THEN LEAST(sub.sold_usd, sub.bought_usd)
                ELSE 0
            END
        ) as volume_usd
    FROM (
        SELECT
            t.block_date,
            (CASE WHEN t.inner_program = '' THEN t.outer_program ELSE t.inner_program END) as program,
            CASE WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112' THEN 1 ELSE 0 END as sold_is_sol,
            CASE WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112' THEN 1 ELSE 0 END as bought_is_sol,
            CASE WHEN t.token_sold_mint IN (SELECT mint FROM stablecoins) THEN 1 ELSE 0 END as sold_is_stable,
            CASE WHEN t.token_bought_mint IN (SELECT mint FROM stablecoins) THEN 1 ELSE 0 END as bought_is_stable,
            CASE
                WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112'
                THEN t.token_sold_amount * COALESCE(psol.price_in_usd, 0)
                ELSE t.token_sold_amount * COALESCE(ps.price_in_usd, 0)
            END as sold_usd,
            CASE
                WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112'
                THEN t.token_bought_amount * COALESCE(psol.price_in_usd, 0)
                ELSE t.token_bought_amount * COALESCE(pb.price_in_usd, 0)
            END as bought_usd
        FROM solana.dex_trades t
        LEFT JOIN sol_prices psol 
            ON DATE_TRUNC('minute', t.block_time) = psol.minute
        LEFT JOIN prices_deduped pb 
            ON t.token_bought_mint = pb.mint
            AND DATE_TRUNC('minute', t.block_time) = pb.minute
            AND t.token_bought_mint <> 'So11111111111111111111111111111111111111112'
        LEFT JOIN prices_deduped ps 
            ON t.token_sold_mint = ps.mint
            AND DATE_TRUNC('minute', t.block_time) = ps.minute
            AND t.token_sold_mint <> 'So11111111111111111111111111111111111111112'
        WHERE DATE_TRUNC('month', t.block_date) = DATE('2026-03-01')
          AND t.block_date < CURRENT_DATE
          AND t.pool_address NOT IN (SELECT pool_address FROM excluded_pools)
    ) sub
    JOIN program_names pn ON sub.program = pn.program
    GROUP BY 1, 2, 3
)

SELECT
    block_date,
    program,
    program_name,
    ROUND(volume_usd, 2) as daily_volume_usd,
    ROUND(SUM(volume_usd) OVER (PARTITION BY program ORDER BY block_date), 2) as cumulative_volume_usd
FROM program_volume
ORDER BY 1 DESC, 4 DESC
]
