        ('USD1ttGY1N17NEEHLmELoaybftRBUSErhqYiQzvEmuB')
    ) AS t(mint)
),

prices_deduped AS (
    SELECT mint, minute, MAX(price_in_usd) as price_in_usd
    FROM solana.token_prices_1m
    WHERE mint <> 'FATYxjEcXNYinyoR8SzHBKtzLz8qYRdUaHpxPS7dvirt'
    GROUP BY mint, minute
),

sol_prices AS (
    SELECT minute, price_in_usd
    FROM prices_deduped
    WHERE mint = 'So11111111111111111111111111111111111111112'
),

categorized AS (
    SELECT
        block_date,
        -- Non-overlapping categories
        CASE
            -- SOL-Stable: one side SOL, other side stablecoin
            WHEN (sold_is_sol = 1 AND bought_is_stable = 1) OR (bought_is_sol = 1 AND sold_is_stable = 1) 
                THEN 'SOL-Stable'
            -- SOL-Other: one side SOL, other side NOT stablecoin
            WHEN (sold_is_sol = 1 AND bought_is_stable = 0) OR (bought_is_sol = 1 AND sold_is_stable = 0)
                THEN 'SOL-Other'
            -- Stable-Other: one side stablecoin, other side NOT SOL and NOT stablecoin
            WHEN (sold_is_stable = 1 AND bought_is_sol = 0 AND bought_is_stable = 0) 
              OR (bought_is_stable = 1 AND sold_is_sol = 0 AND sold_is_stable = 0)
                THEN 'Stable-Other'
            -- Stable-Stable: both sides stablecoin
            WHEN sold_is_stable = 1 AND bought_is_stable = 1
                THEN 'Stable-Stable'
            -- Other-Other: neither SOL nor stablecoin on either side
            ELSE 'Other-Other'
        END as pool_category,
        is_prop_amm,
        CASE
            WHEN sold_is_sol = 1 AND sold_usd > 0 THEN sold_usd
            WHEN bought_is_sol = 1 AND bought_usd > 0 THEN bought_usd
            WHEN sold_is_stable = 1 AND sold_usd > 0 THEN sold_usd
            WHEN bought_is_stable = 1 AND bought_usd > 0 THEN bought_usd
            WHEN sold_usd > 0 AND bought_usd > 0 THEN LEAST(sold_usd, bought_usd)
            ELSE 0
        END as volume_usd
    FROM (
        SELECT
            t.block_date,
            CASE WHEN po.program IS NOT NULL OR pi.program IS NOT NULL THEN true ELSE false END as is_prop_amm,
            CASE WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112' THEN 1 ELSE 0 END as sold_is_sol,
            CASE WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112' THEN 1 ELSE 0 END as bought_is_sol,
            CASE WHEN ss.mint IS NOT NULL THEN 1 ELSE 0 END as sold_is_stable,
            CASE WHEN sb.mint IS NOT NULL THEN 1 ELSE 0 END as bought_is_stable,
            CASE WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112'
                THEN t.token_sold_amount * COALESCE(psol.price_in_usd, 0)
                ELSE t.token_sold_amount * COALESCE(ps.price_in_usd, 0)
            END as sold_usd,
            CASE WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112'
                THEN t.token_bought_amount * COALESCE(psol.price_in_usd, 0)
                ELSE t.token_bought_amount * COALESCE(pb.price_in_usd, 0)
            END as bought_usd
        FROM solana.dex_trades t
        LEFT JOIN prop_amms po ON t.outer_program = po.program
        LEFT JOIN prop_amms pi ON t.inner_program = pi.program
        LEFT JOIN stablecoins ss ON t.token_sold_mint = ss.mint
        LEFT JOIN stablecoins sb ON t.token_bought_mint = sb.mint
        LEFT JOIN sol_prices psol 
            ON DATE_TRUNC('minute', t.block_time) = psol.minute
        LEFT JOIN prices_deduped pb 
            ON t.token_bought_mint = pb.mint
            AND DATE_TRUNC('minute', t.block_time) = pb.minute
            AND t.token_bought_mint <> 'So11111111111111111111111111111111111111112'
        LEFT JOIN prices_deduped ps 
            ON t.token_sold_mint = ps.mint
            AND DATE_TRUNC('minute', t.block_time) = ps.minute
            AND t.token_sold_mint <> 'So11111111111111111111111111111111111111112'
        WHERE DATE_TRUNC('month', t.block_date) = DATE('2026-03-01')
          AND t.block_date < CURRENT_DATE
          AND t.pool_address NOT IN (SELECT pool_address FROM excluded_pools)
    ) sub
),

daily_agg AS (
    SELECT
        block_date,
        pool_category,
        SUM(CASE WHEN is_prop_amm THEN volume_usd ELSE 0 END) as prop_amm_volume_usd,
        SUM(volume_usd) as total_volume_usd
    FROM categorized
    GROUP BY 1, 2
)

SELECT
    block_date,
    pool_category,
    ROUND(prop_amm_volume_usd, 2) as prop_amm_volume_usd,
    ROUND(total_volume_usd, 2) as total_volume_usd,
    ROUND(prop_amm_volume_usd * 100.0 / SUM(prop_amm_volume_usd) OVER (PARTITION BY block_date), 2) as pct_of_prop_amm_volume,
    ROUND(total_volume_usd * 100.0 / SUM(total_volume_usd) OVER (PARTITION BY block_date), 2) as pct_of_total_volume
FROM daily_agg
ORDER BY 1 DESC, 4 DESC
]
