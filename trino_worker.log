),

cte_transfers AS (
    SELECT
        a.block_date,
        a.mint,
        token_supply,
        p2p_volume,
        p2p_fee_payer,
        p2p_transfers,
        volume,
        transfers,
        fee_payer,
        program_interacted,
        (volume * 1.00 / transfers) AS avg_transfer_size,
        (p2p_volume * 1.00 / p2p_transfers) AS p2p_avg_transfer_size,
        (volume / 30) * 1.00 / token_supply AS velocity,
        (p2p_volume / 30) * 1.00 / token_supply AS p2p_velocity
    FROM (
        SELECT
            block_date,
            mint,
            SUM(CASE WHEN outer_program='TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA' THEN args.amount END) AS p2p_volume,
            COUNT(DISTINCT CASE WHEN outer_program='TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA' THEN signer END) AS p2p_fee_payer,
            COUNT(CASE WHEN outer_program='TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA' THEN 1 END) AS p2p_transfers,
            SUM(args.amount) AS volume,
            COUNT(1) AS transfers,
            COUNT(DISTINCT signer) AS fee_payer,
            COUNT(DISTINCT outer_program) AS program_interacted
        FROM solana.spl_token sp
        WHERE DATE_TRUNC('month', sp.block_date) = DATE('2026-03-01')
            AND sp.block_date >= DATE('2026-01-01')
            AND sp.block_date < CURRENT_DATE
            AND instruction_type IN ('Transfer','TransferChecked')
            AND mint IN (select address from mint_mapping where program='spl_token')
        GROUP BY 1, 2
        UNION ALL

        SELECT
            block_date,
            mint,
            SUM(CASE WHEN outer_program IS NULL THEN args.amount END) AS p2p_volume,
            COUNT(DISTINCT CASE WHEN outer_program IS NULL THEN signer END) AS p2p_fee_payer,
            COUNT(CASE WHEN outer_program IS NULL THEN 1 END) AS p2p_transfers,
            SUM(args.amount) AS volume,
            COUNT(1) AS transfers,
            COUNT(DISTINCT signer) AS fee_payer,
            COUNT(DISTINCT outer_program) AS program_interacted
        FROM solana.spl_token_22 sp22
        WHERE DATE_TRUNC('month', sp22.block_date) = DATE('2026-03-01')
            AND sp22.block_date >= DATE('2026-01-01')
            AND sp22.block_date < CURRENT_DATE
            AND instruction_type IN ('Transfer','TransferChecked')
            AND mint IN (select address from mint_mapping where program='spl_token_22')
        GROUP BY 1, 2
    ) a
    JOIN (
        SELECT block_date, mint, token_supply
        FROM solana.stablecoin_supply_holders
        WHERE DATE_TRUNC('month', block_date) = DATE('2026-03-01')
            AND block_date >= DATE('2026-01-01')
            AND block_date < CURRENT_DATE
    ) b ON a.block_date = b.block_date AND a.mint = b.mint
)

SELECT
    block_date,
    A.mint AS mint_address,
    mp.symbol AS mint,
    transfers,
    p2p_transfers,
    volume/pow(10,decimals) AS volume_usd,
    p2p_volume /pow(10,decimals) AS p2p_volume,
    avg_transfer_size /pow(10,decimals) AS avg_transfer_size,
    p2p_avg_transfer_size /pow(10,decimals) AS p2p_avg_transfer_size,
    velocity /pow(10,decimals) AS velocity,
    p2p_velocity /pow(10,decimals) AS p2p_velocity
FROM cte_transfers A
JOIN mint_mapping mp ON A.mint = mp.address
ORDER BY 1 DESC, 6 DESC
