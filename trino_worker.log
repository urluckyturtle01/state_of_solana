    SELECT
        address AS mint,
        decimals,
        program,
        CASE category
            WHEN 'Stablecoin' THEN 'stablecoins'
            WHEN 'YBT' THEN 'yield_bearing_tokens'
            WHEN 'xStocks' THEN 'xstocks'
            WHEN 'Tokenized Funds' THEN 'tokenized_funds'
            WHEN 'Tokenized Commodities' THEN 'tokenized_commodities'
        END AS category
    FROM solana.rwa_tokens_mapping
    WHERE category IN ('Stablecoin', 'YBT', 'xStocks', 'Tokenized Funds', 'Tokenized Commodities')
      AND address not in (
        'A94X2fRy3wydNShU4dRaDyap2UuoeWJGWyATtyp61WZf',
        'dngKhBQM3BGvsDHKhrLnjvRKfY5Q7gEnYGToj9Lk8rk',
