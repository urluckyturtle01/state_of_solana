trade_rows AS (
    SELECT 
        t.block_date,
        t.signer,
        t.block_slot,
        t.tx_index,
        CASE WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112' THEN 1 ELSE 0 END as sold_is_sol,
        CASE WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112' THEN 1 ELSE 0 END as bought_is_sol,
        CASE WHEN t.token_sold_mint IN (SELECT mint FROM stablecoins) THEN 1 ELSE 0 END as sold_is_stable,
        CASE WHEN t.token_bought_mint IN (SELECT mint FROM stablecoins) THEN 1 ELSE 0 END as bought_is_stable,
        CASE WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112'
            THEN t.token_sold_amount * COALESCE(psol.price_in_usd, 0)
            ELSE t.token_sold_amount * COALESCE(ps.price_in_usd, 0)
        END as sold_usd,
        CASE WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112'
            THEN t.token_bought_amount * COALESCE(psol.price_in_usd, 0)
            ELSE t.token_bought_amount * COALESCE(pb.price_in_usd, 0)
        END as bought_usd
    FROM solana.dex_trades t
    LEFT JOIN sol_prices psol 
        ON DATE_TRUNC('minute', t.block_time) = psol.minute
    LEFT JOIN prices_deduped pb 
