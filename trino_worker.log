    DATE('2026-03-01') as month,
    ap.aggregator,
    COUNT(DISTINCT t.signer) AS active_traders
FROM solana.dex_trades t
INNER JOIN aggregator_programs ap ON t.outer_program = ap.program_id
WHERE DATE_TRUNC('month', t.block_date) = DATE('2026-03-01')
  AND t.block_date < CURRENT_DATE
GROUP BY 2
ORDER BY 3 DESC
]
