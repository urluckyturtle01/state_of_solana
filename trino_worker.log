[SQL: -- Description: Total volume by pool category
-- Shows volume distribution across SOL-stable, stable-stable, and others
-- Volume priority: SOL side → Stablecoin side → MIN(both sides)

/*
Logic:
- SOL-stable: one token is SOL, other is stablecoin
- Stable-stable: both tokens are stablecoins
- Others: everything else
- Volume priority: SOL > Stablecoin > MIN(both)
- Daily and cumulative totals per category
*/

WITH excluded_pools AS (
    SELECT DISTINCT pool_address
    FROM orca.whirlpool_config
    WHERE config <> '2LecshUwdy9xi7meFgHtFJQNSKk4KdTrcpvaB56dP2NQ'
),

stablecoins AS (
    SELECT mint FROM (VALUES 
        ('EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v'),
        ('Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB'),
        ('2b1kV6DkPAnxd5ixfnxCpjxmKwqjjaYmCZfHsFu24GXo'),
        ('DEkqHyPN7GMRJ5cArtQFAWefqbZb33Hyf6s5iCwjEonT'),
        ('USDSwr9ApdHk5bvJKMjzff41FfuX8bSxdKcR81vTwcA'),
        ('9zNQRsGLjNKwCUU5Gq5LR8beUCPzQMVMqKAi3SSZh54u'),
        ('HzwqbKZw8HxMN6bF2yFZNrht3c2iXXzpKcFu7uBEDKtr'),
        ('susdabGDNbhrnCa6ncrYo81u4s9GM8ecK2UwMyZiq4X'),
        ('AUSD1jCcCyPLybk1YnvPWsHQSrZ46dxwoMniN4N2UEB9'),
        ('2VhjJ9WxaGC3EZFwJG9BDUs9KxKCAjQY4vgd1qxgYWVg'),
        ('A1KLoBrKBde8Ty9qtNQUtq3C2ortoC3u7twggz7sEto6'),
        ('2u1tszSeqZ3qBWF3uNGPFc8TzMk2tdiwknnRMWGWjGWH'),
        ('5H4voZhzySsVvwVYDAKku8MZGuYBC7cXaBKDPW4YHWW1'),
        ('C4Kkr9NZU3VbyedcgutU6LKmi6MKz81sx6gRmk5pX519'),
        ('AhhdRu5YZdjVkKR3wbnUDaymVQL2ucjMQ63sZ3LFHsch'),
        ('9TPL8droGJ7jThsq4momaoz6uhTcvX2SeMqipoPmNa8R'),
        ('Crn4x1Y2HUKko7ox2EZMT6N2t2ZyH7eKtwkBGVnhEq1g'),
        ('FrBfWJ4qE5sCzKm3k3JaAtqZcXUh4LvJygDeketsrsH4'),
        ('AvZZF1YaZDziPY2RCK4oJrRVrbN3mTD9NL24hPeaZeUj'),
        ('6FrrzDk5mQARGc1TDYoyVnSyRdds1t4PbtohCD6p3tgG'),
        ('USD1ttGY1N17NEEHLmELoaybftRBUSErhqYiQzvEmuB')
    ) AS t(mint)
),

prices_deduped AS (
    SELECT mint, minute, MAX(price_in_usd) as price_in_usd
    FROM solana.token_prices_1m
    WHERE mint <> 'FATYxjEcXNYinyoR8SzHBKtzLz8qYRdUaHpxPS7dvirt'
    GROUP BY mint, minute
),

sol_prices AS (
    SELECT minute, price_in_usd
    FROM prices_deduped
    WHERE mint = 'So11111111111111111111111111111111111111112'
),

trade_rows AS (
    SELECT 
        t.block_date,
        CASE
            WHEN (t.token_sold_mint = 'So11111111111111111111111111111111111111112' AND sb.mint IS NOT NULL) 
              OR (ss.mint IS NOT NULL AND t.token_bought_mint = 'So11111111111111111111111111111111111111112') THEN 'SOL-stable'
            WHEN ss.mint IS NOT NULL AND sb.mint IS NOT NULL THEN 'stable-stable'
            ELSE 'others'
        END as pool_category,
        CASE WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112' THEN 1 ELSE 0 END as sold_is_sol,
        CASE WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112' THEN 1 ELSE 0 END as bought_is_sol,
        CASE WHEN ss.mint IS NOT NULL THEN 1 ELSE 0 END as sold_is_stable,
        CASE WHEN sb.mint IS NOT NULL THEN 1 ELSE 0 END as bought_is_stable,
        CASE WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112'
            THEN t.token_sold_amount * COALESCE(psol.price_in_usd, 0)
            ELSE t.token_sold_amount * COALESCE(ps.price_in_usd, 0)
        END as sold_usd,
        CASE WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112'
            THEN t.token_bought_amount * COALESCE(psol.price_in_usd, 0)
            ELSE t.token_bought_amount * COALESCE(pb.price_in_usd, 0)
        END as bought_usd
    FROM solana.dex_trades t
    LEFT JOIN stablecoins ss ON t.token_sold_mint = ss.mint
    LEFT JOIN stablecoins sb ON t.token_bought_mint = sb.mint
    LEFT JOIN sol_prices psol 
        ON DATE_TRUNC('minute', t.block_time) = psol.minute
    LEFT JOIN prices_deduped pb 
        ON t.token_bought_mint = pb.mint
        AND DATE_TRUNC('minute', t.block_time) = pb.minute
        AND t.token_bought_mint <> 'So11111111111111111111111111111111111111112'
    LEFT JOIN prices_deduped ps 
        ON t.token_sold_mint = ps.mint
        AND DATE_TRUNC('minute', t.block_time) = ps.minute
        AND t.token_sold_mint <> 'So11111111111111111111111111111111111111112'
    WHERE DATE_TRUNC('month', t.block_date) = DATE('2026-03-01')
      AND t.block_date < CURRENT_DATE
      AND t.pool_address NOT IN (SELECT pool_address FROM excluded_pools)
),

categorized_trades AS (
    SELECT 
        block_date,
        pool_category,
        SUM(
            CASE
                WHEN sold_is_sol = 1 AND sold_usd > 0 THEN sold_usd
                WHEN bought_is_sol = 1 AND bought_usd > 0 THEN bought_usd
                WHEN sold_is_stable = 1 AND sold_usd > 0 THEN sold_usd
                WHEN bought_is_stable = 1 AND bought_usd > 0 THEN bought_usd
                WHEN sold_usd > 0 AND bought_usd > 0 THEN LEAST(sold_usd, bought_usd)
                ELSE 0
            END
        ) as volume_usd
    FROM trade_rows
    GROUP BY 1, 2
)

SELECT 
    block_date,
    pool_category,
    ROUND(volume_usd, 2) as daily_volume_usd,
    ROUND(SUM(volume_usd) OVER (PARTITION BY pool_category ORDER BY block_date), 2) as cumulative_volume_usd
FROM categorized_trades
ORDER BY block_date, daily_volume_usd DESC
]
