        ('A1KLoBrKBde8Ty9qtNQUtq3C2ortoC3u7twggz7sEto6'),
        ('2u1tszSeqZ3qBWF3uNGPFc8TzMk2tdiwknnRMWGWjGWH'),
        ('5H4voZhzySsVvwVYDAKku8MZGuYBC7cXaBKDPW4YHWW1'),
        ('C4Kkr9NZU3VbyedcgutU6LKmi6MKz81sx6gRmk5pX519'),
        ('AhhdRu5YZdjVkKR3wbnUDaymVQL2ucjMQ63sZ3LFHsch'),
        ('9TPL8droGJ7jThsq4momaoz6uhTcvX2SeMqipoPmNa8R'),
        ('Crn4x1Y2HUKko7ox2EZMT6N2t2ZyH7eKtwkBGVnhEq1g'),
        ('FrBfWJ4qE5sCzKm3k3JaAtqZcXUh4LvJygDeketsrsH4'),
        ('AvZZF1YaZDziPY2RCK4oJrRVrbN3mTD9NL24hPeaZeUj'),
        ('6FrrzDk5mQARGc1TDYoyVnSyRdds1t4PbtohCD6p3tgG'),
        ('USD1ttGY1N17NEEHLmELoaybftRBUSErhqYiQzvEmuB')
    ) AS t(mint)
),

prices_deduped AS (
    SELECT mint, minute, MAX(price_in_usd) as price_in_usd
    FROM solana.token_prices_1m
    WHERE mint <> 'FATYxjEcXNYinyoR8SzHBKtzLz8qYRdUaHpxPS7dvirt'
    GROUP BY mint, minute
),

sol_prices AS (
    SELECT minute, price_in_usd
    FROM prices_deduped
    WHERE mint = 'So11111111111111111111111111111111111111112'
),

prop_amms AS (
    SELECT * FROM (VALUES
        ('ZERor4xhbUycZ6gb9ntrhqscUcZmAbQDjEAtCf4hbZY', 'ZeroFi'),
        ('9H6tua7jkLhdm3w8BvgpTn5LZNU7g4ZynDmCiNN3q6Rp', 'HumidiFi'),
        ('ALPHAQmeA7bjrVuccPsYPiCvsi428SNwte66Srvs4pHA', 'AlphaQ'),
        ('SV2EYYJyRz2YhfXwXnhNAevDEui5Q6yrfyo13WtupPF', 'SolFi V2'),
        ('goonERTdGsjnkZqWuVjs73BZ3Pb9qoCUdBUL17BnS5j', 'GoonFi'),
        ('TessVdML9pBGgG9yGks7o4HewRaXVAMuoVj4x83GLQH', 'TesseraV'),
        ('obriQD1zbpyLz95G5n7nJe6a4DPjpFwa5XYPoNm113y', 'Obric V2'),
        ('AQU1FRd7papthgdrwPTTq5JacJh8YtwEXaBfKU3bTz45', 'Aquifer'),
        ('BiSoNHVpsVZW2F7rx2eQ59yQwKxzU5NvBcmKshCSUypi', 'BisonFi')
    ) AS t(program, program_name)
),

monthly_pool_volume AS (
    SELECT
        month,
        prop_amm_name,
        pool,
        COUNT(*) as txn_count,
        SUM(
            CASE
                WHEN sold_is_sol = 1 AND sold_usd > 0 THEN sold_usd
                WHEN bought_is_sol = 1 AND bought_usd > 0 THEN bought_usd
                WHEN sold_is_stable = 1 AND sold_usd > 0 THEN sold_usd
                WHEN bought_is_stable = 1 AND bought_usd > 0 THEN bought_usd
                WHEN sold_usd > 0 AND bought_usd > 0 THEN LEAST(sold_usd, bought_usd)
                ELSE 0
            END
        ) as volume_usd
    FROM (
        SELECT
            DATE_TRUNC('month', t.block_date) as month,
            (CASE WHEN pi.program_name IS NOT NULL THEN pi.program_name ELSE po.program_name END) as prop_amm_name,
            CONCAT(
                COALESCE(fa.symbol, SUBSTR(LEAST(t.token_sold_mint, t.token_bought_mint), 1, 4)),
                '-',
                COALESCE(fb.symbol, SUBSTR(GREATEST(t.token_sold_mint, t.token_bought_mint), 1, 4))
            ) as pool,
            CASE WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112' THEN 1 ELSE 0 END as sold_is_sol,
            CASE WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112' THEN 1 ELSE 0 END as bought_is_sol,
            CASE WHEN t.token_sold_mint IN (SELECT mint FROM stablecoins) THEN 1 ELSE 0 END as sold_is_stable,
            CASE WHEN t.token_bought_mint IN (SELECT mint FROM stablecoins) THEN 1 ELSE 0 END as bought_is_stable,
            CASE WHEN t.token_sold_mint = 'So11111111111111111111111111111111111111112'
                THEN t.token_sold_amount * COALESCE(psol.price_in_usd, 0)
                ELSE t.token_sold_amount * COALESCE(ps.price_in_usd, 0)
            END as sold_usd,
            CASE WHEN t.token_bought_mint = 'So11111111111111111111111111111111111111112'
                THEN t.token_bought_amount * COALESCE(psol.price_in_usd, 0)
                ELSE t.token_bought_amount * COALESCE(pb.price_in_usd, 0)
            END as bought_usd
        FROM solana.dex_trades t
        LEFT JOIN prop_amms po ON t.outer_program = po.program
        LEFT JOIN prop_amms pi ON t.inner_program = pi.program
        LEFT JOIN sol_prices psol 
            ON DATE_TRUNC('minute', t.block_time) = psol.minute
        LEFT JOIN prices_deduped pb 
            ON t.token_bought_mint = pb.mint
            AND DATE_TRUNC('minute', t.block_time) = pb.minute
            AND t.token_bought_mint <> 'So11111111111111111111111111111111111111112'
        LEFT JOIN prices_deduped ps 
            ON t.token_sold_mint = ps.mint
            AND DATE_TRUNC('minute', t.block_time) = ps.minute
            AND t.token_sold_mint <> 'So11111111111111111111111111111111111111112'
        LEFT JOIN solana.fungible_token_info fa ON LEAST(t.token_sold_mint, t.token_bought_mint) = fa.address
        LEFT JOIN solana.fungible_token_info fb ON GREATEST(t.token_sold_mint, t.token_bought_mint) = fb.address
        WHERE DATE_TRUNC('month', t.block_date) = DATE('2026-03-01')
          AND DATE_TRUNC('month', t.block_date) >= CURRENT_DATE - INTERVAL '6' month
          AND t.block_date < CURRENT_DATE
          AND t.pool_address NOT IN (SELECT pool_address FROM excluded_pools)
          AND (po.program IS NOT NULL OR pi.program IS NOT NULL)
    ) sub
    GROUP BY 1, 2, 3
),

ranked AS (
    SELECT
        month,
        prop_amm_name,
        pool,
        txn_count,
        volume_usd,
        ROW_NUMBER() OVER (PARTITION BY month, prop_amm_name ORDER BY volume_usd DESC) as pool_rank,
        ROUND(volume_usd * 100.0 / SUM(volume_usd) OVER (PARTITION BY month, prop_amm_name), 1) as pool_share_pct
    FROM monthly_pool_volume
),

formatted AS (
    SELECT
        month,
        prop_amm_name,
        CONCAT(
            pool, ' | ',
            CASE
                WHEN volume_usd >= 1e9 THEN CONCAT(FORMAT('%.2f', volume_usd / 1e9), 'B')
                WHEN volume_usd >= 1e6 THEN CONCAT(FORMAT('%.2f', volume_usd / 1e6), 'M')
                WHEN volume_usd >= 1e3 THEN CONCAT(FORMAT('%.2f', volume_usd / 1e3), 'K')
                ELSE FORMAT('%.2f', volume_usd)
            END, ' | ',
            FORMAT('%.2f', pool_share_pct), '%'
        ) as cell
    FROM ranked
    WHERE pool_rank = 1
)

SELECT
    month,
    MAX(CASE WHEN prop_amm_name = 'BisonFi' THEN cell END) as "BisonFi",
    MAX(CASE WHEN prop_amm_name = 'HumidiFi' THEN cell END) as "HumidiFi",
    MAX(CASE WHEN prop_amm_name = 'AlphaQ' THEN cell END) as "AlphaQ",
    MAX(CASE WHEN prop_amm_name = 'SolFi V2' THEN cell END) as "SolFi V2",
    MAX(CASE WHEN prop_amm_name = 'GoonFi' THEN cell END) as "GoonFi",
    MAX(CASE WHEN prop_amm_name = 'TesseraV' THEN cell END) as "TesseraV",
    MAX(CASE WHEN prop_amm_name = 'Obric V2' THEN cell END) as "Obric V2",
    MAX(CASE WHEN prop_amm_name = 'Aquifer' THEN cell END) as "Aquifer",
    MAX(CASE WHEN prop_amm_name = 'ZeroFi' THEN cell END) as "ZeroFi"
FROM formatted
GROUP BY 1
ORDER BY 1 DESC
]
