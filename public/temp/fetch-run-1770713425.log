SELECT 
    block_date,
    category,
    total_compute_units,
    ROUND(total_compute_units * 100.0 / SUM(total_compute_units) OVER (PARTITION BY block_date), 2) as cu_percentage
FROM (
    SELECT 
        d.block_date,
        COALESCE(p.category, 'other') as category,
        SUM(d.compute_units_consumed) as total_compute_units
    FROM 
    (
        SELECT DISTINCT block_date, block_slot, tx_index, outer_program, compute_units_consumed
        FROM solana.dex_trades
        WHERE block_date >= CURRENT_DATE - INTERVAL '6' MONTH AND block_date < CURRENT_DATE
    ) d
     JOIN program_names p ON d.outer_program = p.program
    GROUP BY d.block_date, COALESCE(p.category, 'other')
)
ORDER BY block_date, total_compute_units DESC
